{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Third Eye",
  "version": "0.1.0",
  "identifier": "com.slastrina.thirdeye",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "title": "Third Eye",
        "width": 720,
        "height": 480,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "focus": false
      },
      {
        "label": "settings",
        "title": "Third Eye Settings",
        "url": "index.html?view=settings",
        "width": 780,
        "height": 600,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "hud-canvas",
        "title": "Third Eye HUD",
        "url": "index.html?view=hud-canvas",
        "width": 800,
        "height": 600,
        "center": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "focus": false
      },
      {
        "label": "hud-pill",
        "title": "Third Eye HUD",
        "url": "index.html?view=hud-pill",
        "width": 600,
        "height": 360,
        "center": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "focus": false
      },
      {
        "label": "tray-panel",
        "title": "Third Eye",
        "url": "index.html?view=tray-panel",
        "width": 336,
        "height": 540,
        "center": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "focus": false
      },
      {
        "label": "memory",
        "title": "Third Eye Memory",
        "url": "index.html?view=memory",
        "width": 780,
        "height": 540,
        "minWidth": 620,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": null
    },
    "resources": [
      "binaries/*"
    ]
  },
  "mainBinaryName": "third-eye"
}